# systemd unit for Training Tracker (Gunicorn)
# Install: sudo cp deploy/training-tracker.service /etc/systemd/system/
#         sudo systemctl daemon-reload
#         sudo systemctl enable --now training-tracker

[Unit]
Description=Training Tracker (Gunicorn)
After=network.target postgresql.service

[Service]
Type=notify
User=www-data
Group=www-data
WorkingDirectory=/opt/training-tracker
EnvironmentFile=/opt/training-tracker/.env
ExecStart=/opt/training-tracker/.venv/bin/gunicorn -b 127.0.0.1:8080 --timeout 120 --workers 2 run:app
ExecReload=/bin/kill -s HUP $MAINPID
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
