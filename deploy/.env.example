# Copy this to /opt/training-tracker/.env (or your app dir) and fill in values.
# Do not commit .env to git.
# After deploy: ensure MAIL_DEFAULT_SENDER is set (e.g. support@trainingtracker.me) and sender is verified in SendGrid.

FLASK_APP=run:app
SECRET_KEY=generate-a-long-random-string-here

# Postgres (create DB and user first — see DEPLOY_VPS.md)
DATABASE_URL=postgresql://training_tracker:YOUR_DB_PASSWORD@localhost/training_tracker

# Optional: Redis for cache and background email (faster). Leave unset to use in-memory cache + thread email.
# REDIS_URL=redis://localhost:6379/0

# Mail: use SendGrid (recommended) or SMTP. Sender must be verified in SendGrid.
# MAIL_DEFAULT_SENDER=support@trainingtracker.me
# SENDGRID_API_KEY=SG.xxx
# Or SMTP (e.g. Gmail app password):
# MAIL_USERNAME=...
# MAIL_PASSWORD=...
# MAIL_SERVER=smtp.gmail.com
# MAIL_PORT=465
# MAIL_USE_SSL=True
